{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "serve-scratch-gpt",
      "type": "shell",
      "command": "python3 -m http.server 4825 --directory \"${workspaceFolder}\"",
      "isBackground": true,
      "presentation": { "reveal": "silent", "panel": "dedicated" },
      "problemMatcher": {
        "pattern": [{ "regexp": ".", "file": 1, "location": 2, "message": 3 }],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Serving HTTP",
          "endsPattern": "Serving HTTP"
        }
      }
    }
  ]
}
